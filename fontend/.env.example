# ─── Backend API ─────────────────────────────────────────────────────────────
# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Domain ───────────────────────────────────────────────────────────────────
# Root domain used for subdomain → tenant resolution
# Local multi-tenant testing: use abc-college.localhost (no value needed)
NEXT_PUBLIC_ROOT_DOMAIN=xyz.com
