# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://erp_user:erp_password@localhost:5432/erp_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be a long random string — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
# Production: https://xyz.com,https://app.xyz.com (and approved tenant origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
# Set to false in production — hides /docs, /redoc, and stack traces
APP_DEBUG=true

# ─── Signup / provisioning ───────────────────────────────────────────────────
# Root domain used for subdomain checks and login URLs (green.xyz.com)
PUBLIC_ROOT_DOMAIN=xyz.com
# Free-trial length in days
TRIAL_DAYS=14
# Default timezone written to newly provisioned tenants
TENANT_DEFAULT_TIMEZONE=Asia/Kolkata
# Frontend URL used for email links (verify, reset-password)
FRONTEND_URL=http://localhost:3000

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Production: fill in real SMTP credentials (e.g. AWS SES, SendGrid SMTP, Gmail App Password)
# Dev: leave SMTP_HOST empty to use console mock mode — emails are printed and marked SENT
EMAIL_ENABLED=true
EMAIL_FORCE_CONSOLE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@xyz.com
SMTP_FROM_NAME=XYZ ERP
SMTP_TLS=true
SMTP_SSL=false

# GMail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASSWORD=your-16-char-app-password (generate in Google Account > Security > App Passwords)
# SMTP_FROM=yourgmail@gmail.com

# AWS SES example:
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=YOUR_SES_SMTP_USER
# SMTP_PASSWORD=YOUR_SES_SMTP_PASSWORD
